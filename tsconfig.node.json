{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.js"]
}
