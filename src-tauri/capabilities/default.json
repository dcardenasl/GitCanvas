{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "dialog:allow-open",
    "core:window:allow-destroy",
    "process:allow-restart",
    "updater:default"
  ]
}
