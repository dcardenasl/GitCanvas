#!/usr/bin/env bash
#
# Style only — check Rust formatting and keep frontend checks scoped to staged files.
#
# `dev` is where work lands quickly. The real gate is the pull request into
# `main`, where CI runs the full matrix: clippy with -D warnings, the complete
# test suite, coverage against its thresholds, the bindings drift check and a
# release build on three operating systems. Running any of that here would buy
# nothing and cost minutes on every commit.
#
# Style stays because it is fast and keeps diffs free of formatting noise.
# Failed checks keep their original diagnostics and add a focused next step.
#
set -Eeuo pipefail

# Hooks do not run through an interactive shell, so the toolchains have to be
# put on PATH explicitly rather than relying on a profile being sourced.
[[ -f "${HOME}/.cargo/env" ]] && source "${HOME}/.cargo/env"
export PATH="/opt/homebrew/bin:${PATH}"

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

fail() {
    echo ""
    echo "  ✖ pre-commit: $1"
    echo "    fix: $2"
    echo ""
    exit 1
}

if ! cargo fmt --all --check; then
    fail "Rust formatting failed" "run cargo fmt --all, then stage only the intended Rust files"
fi

if git diff --cached --quiet; then
    exit 0
fi

STAGED_FILES=()
while IFS= read -r -d '' path; do
    STAGED_FILES+=("${path}")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

ESLINT_FILES=()
PRETTIER_FILES=()
for path in "${STAGED_FILES[@]}"; do
    case "${path}" in
        src/bindings.ts)
            # Generated by tauri-specta and intentionally ignored by ESLint.
            ;;
        *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx)
            ESLINT_FILES+=("${path}")
            PRETTIER_FILES+=("${path}")
            ;;
        *.json|*.json5|*.jsonc|*.css|*.scss|*.less|*.html|*.yaml|*.yml)
            PRETTIER_FILES+=("${path}")
            ;;
    esac
done

if ((${#ESLINT_FILES[@]} > 0)); then
    if ! npm exec -- eslint --max-warnings=0 -- "${ESLINT_FILES[@]}"; then
        fail "ESLint failed for staged source files" "fix the reported diagnostics and rerun ./pre-commit"
    fi
fi

if ((${#PRETTIER_FILES[@]} > 0)); then
    if ! npm exec -- prettier --check -- "${PRETTIER_FILES[@]}"; then
        fail "Prettier failed for staged files" "format the reported files and rerun ./pre-commit"
    fi
fi
